<Window x:Class="SecureBudgetManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secure Budget Manager"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="S"
                    Modifiers="Control"
                    Command="{Binding Workspace.SaveActiveCommand}"/>
        <KeyBinding Key="S"
                    Modifiers="Control+Shift"
                    Command="{Binding CaptureFullPageCommand}"/>
        <KeyBinding Key="Escape"
                    Command="{Binding Workspace.CancelActiveEditorCommand}"/>
    </Window.InputBindings>

    <ContentControl Content="{Binding CurrentScreen}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
</Window>
