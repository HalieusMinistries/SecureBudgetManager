<UserControl x:Class="SecureBudgetManager.App.Views.Editors.BillEditorForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource FieldLabel}" Text="This bill"/>
        <TextBlock Style="{StaticResource CardBody}" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding SelectedReservation.Name}"/>
        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
            <Run Text="Due "/><Run Text="{Binding SelectedReservation.DueDate, Mode=OneWay}"/>
            <Run Text=" · required "/><Run Text="{Binding SelectedReservation.AmountDue, Mode=OneWay}"/>
            <Run Text=" · paid "/><Run Text="{Binding SelectedReservation.AmountPaid, Mode=OneWay}"/>
            <Run Text=" · reserved "/><Run Text="{Binding SelectedReservation.AlreadyReserved, Mode=OneWay}"/>
            <Run Text=" · still needed "/><Run Text="{Binding SelectedReservation.StillRequired, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding SelectedReservation.Status}"/>
        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding SelectedReservation.Consequence}"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Who pays"/>
        <TextBlock Style="{StaticResource HintText}" Text="Unassigned bills stay visible. They are not taken from either person until someone agrees."/>
        <ComboBox Style="{StaticResource FormComboBox}"
                  ItemsSource="{Binding AssignmentOptions}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding EditorAssignment}"
                  AutomationProperties.Name="Bill assignment"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="If one person pays all"/>
        <ComboBox Style="{StaticResource FormComboBox}"
                  ItemsSource="{Binding Members}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding EditorPayer}"
                  AutomationProperties.Name="Person who pays all"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="Shared household — first adult share or amount"/>
        <TextBox Style="{StaticResource FormTextBox}"
                 Text="{Binding EditorFirstShare, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="First adult share"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="Shared household — second adult share or amount"/>
        <TextBox Style="{StaticResource FormTextBox}"
                 Text="{Binding EditorSecondShare, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Second adult share"/>
        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding AssignmentPreview}"/>
        <Button Style="{StaticResource SecondaryButton}"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Content="Show effect before saving"
                Command="{Binding PreviewAssignmentCommand}"
                AutomationProperties.Name="Preview bill assignment"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Record a payment"/>
        <TextBlock Style="{StaticResource HintText}" Text="A payment is money already spent. It is not the same as money reserved in the bank."/>
        <TextBox Style="{StaticResource FormTextBox}"
                 Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Payment amount"/>
        <Button Style="{StaticResource SecondaryButton}"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Content="Record payment"
                Command="{Binding RecordPaymentCommand}"
                AutomationProperties.Name="Record that this bill was paid"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Reserve money already set aside"/>
        <TextBlock Style="{StaticResource HintText}" Text="Reserved money stays in the account but is excluded from safe-to-spend."/>
        <TextBox Style="{StaticResource FormTextBox}"
                 Text="{Binding ReserveAmount, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Amount already set aside"/>
        <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,10,0,0"
                  Content="Keep this money out of safe-to-spend"
                  IsChecked="{Binding ReserveIsProtected}"
                  AutomationProperties.Name="Keep this reserve out of safe to spend"/>
        <Button Style="{StaticResource SecondaryButton}"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Content="Save reserve"
                Command="{Binding SaveReserveCommand}"
                AutomationProperties.Name="Save the recorded reserve"/>
    </StackPanel>
</UserControl>
