<UserControl x:Class="SecureBudgetManager.App.Views.Editors.InternationalTransferEditorForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Visibility="{Binding IsTransferEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding DirectionHint}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Sender / owner name"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Sender, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Transfer sender"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Household owner of the sending account"/>
            <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding OwnerOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SendingOwnerId}" AutomationProperties.Name="Sending account owner"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Recipient"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Transfer recipient"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Recipient category"/>
            <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding RelationshipOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Relationship}" AutomationProperties.Name="Recipient category"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Household owner of the receiving account"/>
            <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding OwnerOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding ReceivingOwnerId}" AutomationProperties.Name="Receiving account owner"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Purpose"/>
            <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding PurposeOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Purpose}" AutomationProperties.Name="Transfer purpose"/>
            <TextBlock Style="{StaticResource HintText}" Text="Choose SamePersonAccounts when this is a transfer between own accounts. That movement is not new income."/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Sending country"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding SendingCountry, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sending country"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Receiving country"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ReceivingCountry, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Receiving country"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Source currency"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding SourceCurrency, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Source currency"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Destination currency"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding DestinationCurrency, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destination currency"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Amount sent (recorded)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding AmountSent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Amount sent"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Exchange rate received (recorded)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ExchangeRate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Exchange rate received"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Amount received (recorded)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding AmountReceived, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Amount received"/>
            <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,12,0,0" Content="Recipient needed a fixed destination amount" IsChecked="{Binding IsFixedDestinationAmount}" AutomationProperties.Name="Fixed destination amount"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Provider"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Transfer provider"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Provider fee (recorded)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ProviderFee, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Provider fee"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Sending-bank fee (recorded)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding SendingBankFee, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sending bank fee"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Intermediary fee (recorded)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding IntermediaryBankFee, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Intermediary bank fee"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Recipient fee (recorded)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding RecipientFee, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recipient fee"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Transfer date"/>
            <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding TransferDate}" AutomationProperties.Name="Transfer date"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="One-time or recurring"/>
            <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding Frequencies}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding TransferFrequency}" AutomationProperties.Name="Transfer frequency"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Tax classification"/>
            <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding ClassificationOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding TaxClassification}" AutomationProperties.Name="Transfer tax classification"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsCommitmentEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="A support commitment is a planned amount. Enter only the USD or ZAR target and expected rate you already have."/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Name"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding CommitmentName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Support commitment name"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Fixed USD to send"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding FixedUsd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fixed USD to send"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Fixed ZAR the recipient must receive"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding FixedZar, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fixed ZAR to receive"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Expected USD to ZAR rate"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ExpectedRate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expected USD to ZAR rate"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Expected fees"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ExpectedFees, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expected transfer fees"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Exchange-rate safety margin (%)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding SafetyMargin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Exchange rate safety margin"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Frequency"/>
            <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding Frequencies}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding CommitmentFrequency}" AutomationProperties.Name="Support frequency"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Hierarchy tier"/>
            <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding TierOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding CommitmentTier}" AutomationProperties.Name="Support hierarchy tier"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Due date"/>
            <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding CommitmentDue}" AutomationProperties.Name="Support due date"/>
        </StackPanel>
    </StackPanel>
</UserControl>
