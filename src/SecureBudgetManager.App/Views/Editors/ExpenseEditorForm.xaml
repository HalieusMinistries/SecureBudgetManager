<UserControl x:Class="SecureBudgetManager.App.Views.Editors.ExpenseEditorForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Visibility="{Binding IsExpenseEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="What this cost is"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Name (required)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expense name"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Who is responsible"/>
            <ComboBox Style="{StaticResource FormComboBox}"
                      ItemsSource="{Binding OwnerOptions}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding EditorOwnerId}"
                      AutomationProperties.Name="Expense owner"/>
            <TextBlock Style="{StaticResource HintText}" Text="Shared household stays unassigned until someone agrees to pay."/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Category"/>
            <ComboBox Style="{StaticResource FormComboBox}"
                      ItemsSource="{Binding CategoryOptions}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding EditorCategory}"
                      AutomationProperties.Name="Expense category"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Essential or optional"/>
            <ComboBox Style="{StaticResource FormComboBox}"
                      ItemsSource="{Binding NecessityOptions}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding EditorNecessity}"
                      AutomationProperties.Name="Expense necessity"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Amount and timing"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Amount ($)"/>
            <TextBox Style="{StaticResource FormTextBox}" Text="{Binding EditorAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expense amount"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="How often"/>
            <ComboBox Style="{StaticResource FormComboBox}"
                      ItemsSource="{Binding FrequencyOptions}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding EditorFrequency}"
                      AutomationProperties.Name="Expense frequency"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Due date (anchors the schedule)"/>
            <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding EditorDueDate}" AutomationProperties.Name="Expense due date"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="End date (optional)"/>
            <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding EditorEndDate}" AutomationProperties.Name="Expense end date"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Fixed or variable"/>
            <ComboBox Style="{StaticResource FormComboBox}"
                      ItemsSource="{Binding VariabilityOptions}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding EditorVariability}"
                      AutomationProperties.Name="Expense variability"/>
            <TextBlock Style="{StaticResource HintText}"
                       Text="For a variable cost, enter the amount you expect to spend each time."
                       Visibility="{Binding IsVariable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Household outflow"/>
            <ComboBox Style="{StaticResource FormComboBox}"
                      ItemsSource="{Binding CoverageOptions}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding EditorCoverage}"
                      AutomationProperties.Name="Expense coverage"/>
            <TextBox Style="{StaticResource FormTextBox}"
                     Text="{Binding EditorCoverageExplanation, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="What covers this expense"/>
            <TextBlock Style="{StaticResource HintText}" Text="{Binding CoverageExplanation}"/>
            <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,12,0,0"
                      Content="This expense is currently active"
                      IsChecked="{Binding EditorIsActive}"
                      AutomationProperties.Name="Expense is active"/>
            <TextBlock Style="{StaticResource HintText}" Text="{Binding EquivalentSummary}"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsSuggestionEditor, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Style="{StaticResource CardBody}" TextWrapping="Wrap"
                       Text="These are proposals, not confirmed bills. Actual fixed amounts stay as recorded. Accept, adjust or exclude each line before saving."/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Income scenario"/>
            <ComboBox Style="{StaticResource FormComboBox}"
                      ItemsSource="{Binding ScenarioOptions}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedScenario}"
                      AutomationProperties.Name="Suggestion scenario"/>
            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding SuggestionSummary}"/>
            <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,8"
                    Content="Accept all safe recommendations"
                    Command="{Binding AcceptAllSafeCommand}"
                    AutomationProperties.Name="Accept all safe recommendations"/>
            <ItemsControl ItemsSource="{Binding SuggestionLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="{Binding Category}"/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                    <Run Text="{Binding AmountKind, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Owner, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Tier, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                    <Run Text="{Binding SuggestedAmount, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding Frequency, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Weekly, Mode=OneWay}"/>
                                    <Run Text=" weekly · "/>
                                    <Run Text="{Binding Monthly, Mode=OneWay}"/>
                                    <Run Text=" average monthly · "/>
                                    <Run Text="{Binding PercentOfNet, Mode=OneWay}"/>
                                    <Run Text=" of relevant net"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Range}"/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Why}"/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Source}"/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding SafeToSpendEffect}"/>
                                <ComboBox Style="{StaticResource FormComboBox}"
                                          ItemsSource="{Binding Decisions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Decision}"
                                          AutomationProperties.Name="Suggestion decision"/>
                                <TextBox Style="{StaticResource FormTextBox}"
                                         Text="{Binding AdjustedAmount, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Adjusted suggestion amount"/>
                                <Button Style="{StaticResource CompactButton}" Content="Restore suggested value"
                                        Command="{Binding DataContext.RestoreSuggestedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
