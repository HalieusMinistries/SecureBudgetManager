<UserControl x:Class="SecureBudgetManager.App.Views.Editors.EditorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:SecureBudgetManager.App.Views.Editors">
    <UserControl.Resources>
        <DataTemplate x:Key="HouseholdEditorTemplate">
            <editors:HouseholdEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="IncomeEditorTemplate">
            <editors:IncomeEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="ExpenseEditorTemplate">
            <editors:ExpenseEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="PayrollEditorTemplate">
            <editors:BenefitEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="AllocationsEditorTemplate">
            <editors:BillEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="GroceryEditorTemplate">
            <editors:GroceryCategoryEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="SavingsEditorTemplate">
            <editors:SavingsEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="DebtEditorTemplate">
            <editors:DebtEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="ActualsEditorTemplate">
            <editors:ActualsEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="ProductsEditorTemplate">
            <editors:ProductEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="PlanningEditorTemplate">
            <editors:PlanningEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="GuidanceEditorTemplate">
            <editors:GuidanceEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="TransfersEditorTemplate">
            <editors:InternationalTransferEditorForm/>
        </DataTemplate>
        <DataTemplate x:Key="ForeignAccountsEditorTemplate">
            <editors:ForeignAccountEditorForm/>
        </DataTemplate>
        <editors:EditorFormTemplateSelector x:Key="EditorFormSelector"
                                            HouseholdTemplate="{StaticResource HouseholdEditorTemplate}"
                                            IncomeTemplate="{StaticResource IncomeEditorTemplate}"
                                            ExpenseTemplate="{StaticResource ExpenseEditorTemplate}"
                                            PayrollTemplate="{StaticResource PayrollEditorTemplate}"
                                            AllocationsTemplate="{StaticResource AllocationsEditorTemplate}"
                                            GroceryTemplate="{StaticResource GroceryEditorTemplate}"
                                            SavingsTemplate="{StaticResource SavingsEditorTemplate}"
                                            DebtTemplate="{StaticResource DebtEditorTemplate}"
                                            ActualsTemplate="{StaticResource ActualsEditorTemplate}"
                                            ProductsTemplate="{StaticResource ProductsEditorTemplate}"
                                            PlanningTemplate="{StaticResource PlanningEditorTemplate}"
                                            GuidanceTemplate="{StaticResource GuidanceEditorTemplate}"
                                            TransfersTemplate="{StaticResource TransfersEditorTemplate}"
                                            ForeignAccountsTemplate="{StaticResource ForeignAccountsEditorTemplate}"/>
    </UserControl.Resources>
    <Grid Background="#99080C10"
          AutomationProperties.Name="Record editor">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="{Binding OverlayWidth}"
                Height="{Binding OverlayHeight}"
                MaxWidth="720"
                MaxHeight="640"
                MinWidth="360"
                MinHeight="280"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Accent}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,16,20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="{Binding CurrentViewModel.EditorTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="Changes are not saved until you choose Save. Cancel leaves the record as it was."/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding CurrentViewModel.EditorEffectPreview}"
                                   Visibility="{Binding CurrentViewModel.EditorEffectPreview, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Border Style="{StaticResource ErrorCard}" Margin="0,10,0,0"
                                Visibility="{Binding CurrentViewModel.HasEditorError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardBody}" Text="{Binding CurrentViewModel.EditorError}"/>
                                <ItemsControl ItemsSource="{Binding CurrentViewModel.FieldErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap">
                                                <Run Text="{Binding Key, Mode=OneWay}"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding Value, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Cancel"
                                    Command="{Binding CurrentViewModel.CancelEditorCommand}"
                                    IsCancel="True"
                                    AutomationProperties.Name="Cancel editor"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0"
                                    Content="{Binding CurrentViewModel.EditorSaveLabel}"
                                    Command="{Binding CurrentViewModel.SaveEditorCommand}"
                                    IsDefault="True"
                                    AutomationProperties.Name="Save editor"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0" VerticalAlignment="Center"
                                   Text="Ctrl+S saves. Escape cancels."/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,12">
                    <ContentControl x:Name="EditorBodyHost"
                                    Content="{Binding CurrentViewModel}"
                                    ContentTemplateSelector="{StaticResource EditorFormSelector}"
                                    HorizontalContentAlignment="Stretch"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
