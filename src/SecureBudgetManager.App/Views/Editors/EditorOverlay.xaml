<UserControl x:Class="SecureBudgetManager.App.Views.Editors.EditorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="clr-namespace:SecureBudgetManager.App.Views.Editors"
             xmlns:vm="clr-namespace:SecureBudgetManager.App.ViewModels">
    <Grid Background="#99080C10"
          AutomationProperties.Name="Record editor">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="{Binding OverlayWidth}"
                Height="{Binding OverlayHeight}"
                MaxWidth="720"
                MaxHeight="640"
                MinWidth="360"
                MinHeight="280"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Accent}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,16,20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="{Binding CurrentViewModel.EditorTitle}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Text="Changes are not saved until you choose Save. Cancel leaves the record as it was."/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding CurrentViewModel.EditorEffectPreview}"
                                   Visibility="{Binding CurrentViewModel.EditorEffectPreview, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Border Style="{StaticResource ErrorCard}" Margin="0,10,0,0"
                                Visibility="{Binding CurrentViewModel.HasEditorError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource CardBody}" Text="{Binding CurrentViewModel.EditorError}"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Cancel"
                                    Command="{Binding CurrentViewModel.CancelEditorCommand}"
                                    IsCancel="True"
                                    AutomationProperties.Name="Cancel editor"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0"
                                    Content="{Binding CurrentViewModel.EditorSaveLabel}"
                                    Command="{Binding CurrentViewModel.SaveEditorCommand}"
                                    IsDefault="True"
                                    AutomationProperties.Name="Save editor"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0" VerticalAlignment="Center"
                                   Text="Ctrl+S saves. Escape cancels."/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,12">
                    <ContentControl Content="{Binding CurrentViewModel}" HorizontalContentAlignment="Stretch">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:HouseholdViewModel}">
                                <editors:HouseholdEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:IncomeViewModel}">
                                <editors:IncomeEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
                                <editors:ExpenseEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:PayrollViewModel}">
                                <editors:BenefitEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:AllocationsViewModel}">
                                <editors:BillEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:GroceryPlanViewModel}">
                                <editors:GroceryCategoryEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SavingsViewModel}">
                                <editors:SavingsEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:DebtViewModel}">
                                <editors:DebtEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ActualsViewModel}">
                                <editors:ActualsEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                                <editors:ProductEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:PlanningViewModel}">
                                <editors:PlanningEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:LocalGuidanceViewModel}">
                                <editors:GuidanceEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:InternationalTransfersViewModel}">
                                <editors:InternationalTransferEditorForm/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:ForeignAccountsViewModel}">
                                <editors:ForeignAccountEditorForm/>
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
