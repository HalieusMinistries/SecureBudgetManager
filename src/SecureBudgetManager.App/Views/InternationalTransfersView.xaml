<UserControl x:Class="SecureBudgetManager.App.Views.InternationalTransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:interaction="clr-namespace:SecureBudgetManager.App.Interaction"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20"
                  interaction:ScrollRestore.VerticalOffset="{Binding ListScrollOffset, Mode=TwoWay}">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>
            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding ConversionSummary}"/>

            <Grid Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Transfers" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add transfer" Command="{Binding BeginAddTransferCommand}" AutomationProperties.Name="Add transfer"/>
            </Grid>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasTransfers, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="No transfers yet"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="Add a completed movement with the sender, recipient, currencies, recorded rate and fees. Click a row to select it. Double-click or choose Edit to open it."/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Transfers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableListRow}" Focusable="True" AutomationProperties.Name="{Binding Parties}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectTransferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditTransferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <KeyBinding Key="Return"
                                            Command="{Binding DataContext.BeginEditTransferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Text="{Binding Parties}"/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Amounts}"/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                        <Run Text="{Binding Purpose, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding Classification, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding Review, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Edit"
                                        Command="{Binding DataContext.BeginEditTransferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Edit transfer"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,16,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Recurring support" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add commitment" Command="{Binding BeginAddCommitmentCommand}" AutomationProperties.Name="Add support commitment"/>
            </Grid>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasCommitments, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="No support commitments yet"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="Add a planned USD or ZAR target when the household already has an expected rate. The programme does not invent one."/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Commitments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableListRow}" Focusable="True" AutomationProperties.Name="{Binding Name}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectCommitmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditCommitmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <KeyBinding Key="Return"
                                            Command="{Binding DataContext.BeginEditCommitmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Reserve}"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Tier}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Edit"
                                        Command="{Binding DataContext.BeginEditCommitmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Edit support commitment"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding ReviewFlags}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
            <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
