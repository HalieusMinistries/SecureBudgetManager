<UserControl x:Class="SecureBudgetManager.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding ProductName}"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="{Binding VersionText}"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding PrivacyNote}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding Category}"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Term}" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource CardBody}" Text="{Binding Explanation}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
