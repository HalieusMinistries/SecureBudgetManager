<UserControl x:Class="SecureBudgetManager.App.Views.GroceryPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Which plan"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding PlanKinds}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedKind}"
                              AutomationProperties.Name="Grocery plan to show"/>
                    <TextBlock Style="{StaticResource CardBody}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding PlanSummary}"/>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding AssistanceSummary}"/>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding FallbackSummary}"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Content="Create this plan from local guidance"
                            Command="{Binding CreatePlanCommand}"
                            AutomationProperties.Name="Create this plan from local guidance"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Categories"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding Essential, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                            <Run Text="Limit "/><Run Text="{Binding WeeklyLimit, Mode=OneWay}"/>
                                            <Run Text=" · spent "/><Run Text="{Binding Spent, Mode=OneWay}"/>
                                            <Run Text=" · remaining "/><Run Text="{Binding Remaining, Mode=OneWay}"/>
                                            <Run Text=" · carried in "/><Run Text="{Binding CarriedForward, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                            <Run Text="Suggested "/><Run Text="{Binding Suggested, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding Ranges, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                            <Run Text="{Binding Rollover, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding Source, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding EffectiveDate, Mode=OneWay}"/>
                                            <Run Text=" · confidence "/><Run Text="{Binding Confidence, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding ReviewState, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Set a category"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Category"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding Categories}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCategory}"
                              AutomationProperties.Name="Grocery category to change"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Weekly limit"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Text="{Binding CategoryLimit, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Weekly limit for this category"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Unspent money at the end of the week"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding RolloverRules}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding CategoryRollover}"
                              AutomationProperties.Name="Rollover rule"/>
                    <CheckBox Margin="0,10,0,0"
                              Content="Essential food, protected before discretionary spending"
                              IsChecked="{Binding CategoryIsEssential}"
                              AutomationProperties.Name="Essential food"/>
                    <CheckBox Margin="0,6,0,0"
                              Content="Normally supplied by food assistance rather than cash"
                              IsChecked="{Binding CategorySuppliedByAssistance}"
                              AutomationProperties.Name="Supplied by food assistance"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Save category"
                                Command="{Binding SaveCategoryCommand}"
                                AutomationProperties.Name="Save this category"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"
                                Content="Remove category"
                                Command="{Binding RemoveCategoryCommand}"
                                AutomationProperties.Name="Remove this category"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Add a custom category"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Name of the new grocery category"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Content="Add category"
                            Command="{Binding AddCategoryCommand}"
                            AutomationProperties.Name="Add the new grocery category"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Food assistance"/>
                    <TextBlock Style="{StaticResource CardBody}"
                               Text="Assistance reduces the cash needed for the categories it actually supplies. It is never counted as income, and never assumed to be permanent."/>
                    <CheckBox Margin="0,10,0,0"
                              Content="Assistance is expected"
                              IsChecked="{Binding AssistanceExpected}"
                              AutomationProperties.Name="Assistance is expected"/>
                    <CheckBox Margin="0,6,0,0"
                              Content="Temporarily suspended"
                              IsChecked="{Binding AssistanceSuspended}"
                              AutomationProperties.Name="Assistance temporarily suspended"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Source"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Text="{Binding AssistanceSource, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Assistance source"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Estimated weekly value in goods"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Text="{Binding AssistanceValue, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Estimated weekly value of assistance"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Effective from"/>
                    <DatePicker Style="{StaticResource FormDatePicker}"
                                SelectedDate="{Binding AssistanceEffective}"
                                AutomationProperties.Name="Assistance effective date"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Review by"/>
                    <DatePicker Style="{StaticResource FormDatePicker}"
                                SelectedDate="{Binding AssistanceReview}"
                                AutomationProperties.Name="Assistance review date"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Content="Save assistance"
                            Command="{Binding SaveAssistanceCommand}"
                            AutomationProperties.Name="Save the assistance details"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Warnings"/>
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
