<UserControl x:Class="SecureBudgetManager.App.Views.HouseholdImportPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource PageKicker}" Text="PENDING IMPORT"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="Review household import"/>
            <TextBlock Style="{StaticResource PageLead}"
                       Text="Nothing has been written yet. Confirming saves through the local database, reloads the data, then deletes the import file. Cancelling keeps the file and leaves the database unchanged."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Source"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="{Binding SourcePath}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding CreatedLocalText}"/>
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,16,0,0" Text="Preview"/>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Summary}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Records to create"/>
                    <ItemsControl ItemsSource="{Binding Created}"/>
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,16,0,0" Text="Records to update"/>
                    <ItemsControl ItemsSource="{Binding Updated}"/>
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,16,0,0" Text="Unchanged"/>
                    <ItemsControl ItemsSource="{Binding Unchanged}"/>
                    <TextBlock Style="{StaticResource CardTitle}" Margin="0,16,0,0" Text="Conflicts"/>
                    <ItemsControl ItemsSource="{Binding Conflicts}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Verification"/>
                    <ItemsControl ItemsSource="{Binding Checks}"/>
                    <CheckBox Style="{StaticResource ThemedCheckBox}"
                              Margin="0,16,0,0"
                              Content="Apply incoming values where existing records conflict"
                              IsChecked="{Binding AcceptConflicts}"
                              Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.Name="Accept import conflicts"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ErrorCard}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource CardBody}" Text="{Binding ErrorMessage}"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        Content="Confirm and save"
                        Command="{Binding ConfirmCommand}"
                        AutomationProperties.Name="Confirm household import"/>
                <Button Style="{StaticResource SecondaryButton}"
                        Margin="12,0,0,0"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        AutomationProperties.Name="Cancel household import"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
