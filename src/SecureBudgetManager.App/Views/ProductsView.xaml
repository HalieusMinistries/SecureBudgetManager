<UserControl x:Class="SecureBudgetManager.App.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:interaction="clr-namespace:SecureBudgetManager.App.Interaction"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20"
                  interaction:ScrollRestore.VerticalOffset="{Binding ListScrollOffset, Mode=TwoWay}">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Products" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add product" Command="{Binding BeginAddCommand}" AutomationProperties.Name="Add product"/>
            </Grid>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasProducts, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="No products yet"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="Add a named product with its pack size. A larger pack is not assumed cheaper until you record a shelf price."/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableListRow}" Focusable="True" AutomationProperties.Name="{Binding Name}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <KeyBinding Key="Return"
                                            Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Text="{Binding Name}"/>
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding Brand, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding Size, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding Status, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Edit"
                                        Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Edit product"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource CardTitle}" Margin="0,16,0,8" Text="Price observations"/>
            <ItemsControl ItemsSource="{Binding Prices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Text="{Binding Product}"/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Unit}"/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                    <Run Text="{Binding Retailer, Mode=OneWay}"/>
                                    <Run Text=" · shelf "/><Run Text="{Binding Shelf, Mode=OneWay}"/>
                                    <Run Text=" · working "/><Run Text="{Binding Working, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding Observed, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding Freshness, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding TaxNote}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
            <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
