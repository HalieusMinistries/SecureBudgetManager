<UserControl x:Class="SecureBudgetManager.App.Views.HouseholdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Household name"/>
                    <TextBlock x:Name="HouseholdNameLabel" Style="{StaticResource FieldLabel}" Text="Name" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Text="{Binding HouseholdName, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Household name"
                             AutomationProperties.LabeledBy="{Binding ElementName=HouseholdNameLabel}"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Content="Save household name"
                            Command="{Binding SaveHouseholdCommand}"
                            AutomationProperties.Name="Save household name"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="No members yet"/>
                    <TextBlock Style="{StaticResource CardBody}"
                               Text="Add the people in this household. First names or nicknames are enough."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Members" VerticalAlignment="Center" Margin="0"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="Add member"
                            Command="{Binding BeginAddCommand}"
                            AutomationProperties.Name="Add household member"/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Members}"
                          Visibility="{Binding HasMembers, Converter={StaticResource BooleanToVisibilityConverter}}"
                          KeyboardNavigation.TabNavigation="Continue">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableListRow}"
                                Focusable="True"
                                AutomationProperties.Name="{Binding Name}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <KeyBinding Key="Return"
                                            Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource Brush.Text}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Style="{StaticResource HintText}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CompactButton}"
                                            Content="Edit"
                                            Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Edit member"/>
                                    <Button Style="{StaticResource CompactButton}"
                                            Content="Archive"
                                            Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Archive or reactivate member"/>
                                    <Button Style="{StaticResource DangerButton}"
                                            Padding="10,6"
                                            FontSize="12"
                                            Content="Remove"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove member"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource ErrorCard}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource CardBody}"
                           Foreground="{StaticResource Brush.Text}"
                           Text="{Binding ErrorMessage}"/>
            </Border>

            <TextBlock Style="{StaticResource HintText}"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
