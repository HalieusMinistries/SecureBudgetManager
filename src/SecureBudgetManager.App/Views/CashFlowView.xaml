<UserControl x:Class="SecureBudgetManager.App.Views.CashFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Starting balance"/>
                    <TextBlock Style="{StaticResource CardBody}"
                               Text="Type the balance you can see today. It is stored only in the local database. No bank login is used."/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Account name"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cash flow account name"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Starting balance"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding StartingBalanceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Starting bank balance"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Content="Save starting balance"
                            Command="{Binding SaveStartingBalanceCommand}"
                            AutomationProperties.Name="Save starting balance"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Hour assumption"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding AssumptionOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Assumption}"
                              AutomationProperties.Name="Cash flow hour assumption"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding MixHint}"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Lowest balance"/>
                        <TextBlock Style="{StaticResource CardBody}" Text="{Binding LowestBalanceText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Next payday"/>
                        <TextBlock Style="{StaticResource CardBody}" Text="{Binding NextPaydayText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Bills before payday"/>
                        <TextBlock Style="{StaticResource CardBody}" Text="{Binding BillsBeforePaydayText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Five-paycheque months"/>
                        <TextBlock Style="{StaticResource CardBody}" Text="{Binding FivePaychequeText}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Potential overdraft dates"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="{Binding OverdraftDatesText}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="90-day calendar"/>
                    <ItemsControl ItemsSource="{Binding Days}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Date}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Events}"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Closing, StringFormat=Closing {0}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="No projected days yet. Add income, expenses and a starting balance."
                               Visibility="{Binding ShowEmptyCalendar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
