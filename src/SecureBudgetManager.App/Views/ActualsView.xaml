<UserControl x:Class="SecureBudgetManager.App.Views.ActualsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Record a transaction"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Description"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Transaction description"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Amount"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Transaction amount"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Date"/>
                    <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding Date}" AutomationProperties.Name="Transaction date"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Category"/>
                    <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding CategoryName}" AutomationProperties.Name="Transaction category"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Linked planned expense"/>
                    <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding ExpenseOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding LinkedExpenseId}" AutomationProperties.Name="Linked expense"/>
                    <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,12,0,0" Content="Refund or reimbursement" IsChecked="{Binding IsRefund}" AutomationProperties.Name="Is refund"/>
                    <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,8,0,0" Content="This is one line of a split transaction" IsChecked="{Binding IsSplitLine}" AutomationProperties.Name="Is split line"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Notes"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Transaction notes"/>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Save transaction" Command="{Binding AddTransactionCommand}" AutomationProperties.Name="Save transaction"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Transactions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding Date, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Amount, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Kind, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource CompactButton}" Content="Reconcile"
                                            Command="{Binding DataContext.ConfirmTransactionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Reconcile transaction"/>
                                    <Button Style="{StaticResource DangerButton}" Padding="10,6" FontSize="12" Content="Remove"
                                            Command="{Binding DataContext.RemoveTransactionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove transaction"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Budget versus actual this month"/>
                    <ItemsControl ItemsSource="{Binding Comparisons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource HintText}">
                                            <Run Text="Expected "/>
                                            <Run Text="{Binding Expected, Mode=OneWay}"/>
                                            <Run Text=" · actual "/>
                                            <Run Text="{Binding Actual, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Difference, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Note}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Actual payslip"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="Compare a real payslip with the estimate. Mileage reimbursement is stored separately from taxable earnings."/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Income source"/>
                    <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding IncomeOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedIncomeId}" AutomationProperties.Name="Payslip income source"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pay date"/>
                    <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding PayslipDate}" AutomationProperties.Name="Payslip date"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Gross pay"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipGross, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip gross"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Federal withholding"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipFederal, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip federal"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Utah / state withholding"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipState, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip state"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Social Security"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipSocialSecurity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip Social Security"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Medicare"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipMedicare, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip Medicare"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Other pre-tax deductions"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipPreTax, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip pre-tax"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Post-tax deductions"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipPostTax, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip post-tax"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mileage or other non-taxable reimbursement"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipReimbursement, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip reimbursement"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Hours worked"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PayslipHours, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Payslip hours"/>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Save payslip" Command="{Binding AddPayslipCommand}" AutomationProperties.Name="Save payslip"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="{Binding ComparisonNote}"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Payslips}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource HintText}">
                                    <Run Text="{Binding Date, Mode=OneWay}"/>
                                    <Run Text=" · gross "/>
                                    <Run Text="{Binding Gross, Mode=OneWay}"/>
                                    <Run Text=" · net "/>
                                    <Run Text="{Binding Net, Mode=OneWay}"/>
                                    <Run Text=" · reimbursement "/>
                                    <Run Text="{Binding Mileage, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Carry balance forward"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Closing / next starting balance"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding CarryForwardText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Carry forward balance"/>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Save as next starting balance" Command="{Binding CarryBalanceForwardCommand}" AutomationProperties.Name="Carry balance forward"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
