<UserControl x:Class="SecureBudgetManager.App.Views.ActualsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Recorded transactions" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="Add transaction" Command="{Binding BeginAddTransactionCommand}" AutomationProperties.Name="Add transaction"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Add payslip" Command="{Binding BeginAddPayslipCommand}" AutomationProperties.Name="Add payslip"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Transactions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableListRow}" Focusable="True" AutomationProperties.Name="{Binding Description}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditTransactionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <KeyBinding Key="Return"
                                            Command="{Binding DataContext.BeginEditTransactionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding Date, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Amount, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Kind, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource CompactButton}" Content="Edit"
                                            Command="{Binding DataContext.BeginEditTransactionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Edit transaction"/>
                                    <Button Style="{StaticResource CompactButton}" Content="Reconcile"
                                            Command="{Binding DataContext.ConfirmTransactionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Reconcile transaction"/>
                                    <Button Style="{StaticResource DangerButton}" Padding="10,6" FontSize="12" Content="Remove"
                                            Command="{Binding DataContext.RemoveTransactionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove transaction"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Budget versus actual this month"/>
                    <ItemsControl ItemsSource="{Binding Comparisons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource HintText}">
                                            <Run Text="Expected "/>
                                            <Run Text="{Binding Expected, Mode=OneWay}"/>
                                            <Run Text=" · actual "/>
                                            <Run Text="{Binding Actual, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Difference, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Note}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource CardTitle}" Text="Recorded payslips"/>
            <ItemsControl ItemsSource="{Binding Payslips}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource HintText}">
                                    <Run Text="{Binding Date, Mode=OneWay}"/>
                                    <Run Text=" · gross "/>
                                    <Run Text="{Binding Gross, Mode=OneWay}"/>
                                    <Run Text=" · net "/>
                                    <Run Text="{Binding Net, Mode=OneWay}"/>
                                    <Run Text=" · reimbursement "/>
                                    <Run Text="{Binding Mileage, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Carry balance forward"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Closing / next starting balance ($)"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding CarryForwardText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Carry forward balance"/>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Save as next starting balance" Command="{Binding CarryBalanceForwardCommand}" AutomationProperties.Name="Carry balance forward"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="{Binding ComparisonNote}"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
