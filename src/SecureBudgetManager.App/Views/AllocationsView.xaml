<UserControl x:Class="SecureBudgetManager.App.Views.AllocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasReservations, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="No bills yet"/>
                    <TextBlock Style="{StaticResource CardBody}"
                               Text="Add rent and other recurring costs on Expenses. They appear here so you can assign who pays, record a payment, or reserve money already set aside."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Bills and reservations"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="{Binding Totals}"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Click a bill to select it. Double-click or choose Open to assign, pay, or reserve without leaving this list."/>
                    <ItemsControl ItemsSource="{Binding Reservations}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SelectableListRow}"
                                        Focusable="True"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                        <KeyBinding Key="Return"
                                                    Command="{Binding DataContext.OpenBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Owner, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Classification, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                                <Run Text="{Binding Category, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Priority, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Frequency, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                                <Run Text="Required "/><Run Text="{Binding AmountDue, Mode=OneWay}"/>
                                                <Run Text=" · due "/><Run Text="{Binding DueDate, Mode=OneWay}"/>
                                                <Run Text=" · paid "/><Run Text="{Binding AmountPaid, Mode=OneWay}"/>
                                                <Run Text=" · reserved "/><Run Text="{Binding AlreadyReserved, Mode=OneWay}"/>
                                                <Run Text=" · still required "/><Run Text="{Binding StillRequired, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Status}"/>
                                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Consequence}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource CompactButton}"
                                                VerticalAlignment="Center"
                                                Content="Open"
                                                Command="{Binding DataContext.OpenBillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Open bill details"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Shared cost contributions"/>
                    <TextBlock Style="{StaticResource CardBody}" TextWrapping="Wrap" Text="{Binding SplitSummary}"/>
                    <ItemsControl ItemsSource="{Binding Shares}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding Percent, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding Amount, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                            <Run Text="Proportional result "/><Run Text="{Binding DefaultAmount, Mode=OneWay}"/>
                                            <Run Text=" · "/><Run Text="{Binding Difference, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding RoundingNote}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding OverrideSummary}"/>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding RoundingSummary}"/>
                    <ItemsControl ItemsSource="{Binding SplitWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Transfer between personal balances"/>
                    <TextBlock Style="{StaticResource CardBody}"
                               Text="Nothing here happens automatically. A transfer moves money only between the two people you name."/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="From"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding Members}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding TransferFrom}"
                              AutomationProperties.Name="Transfer sender"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="To"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding Members}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding TransferTo}"
                              AutomationProperties.Name="Transfer recipient"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Amount"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Transfer amount"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Date"/>
                    <DatePicker Style="{StaticResource FormDatePicker}"
                                SelectedDate="{Binding TransferDate}"
                                AutomationProperties.Name="Transfer date"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Purpose or note"/>
                    <TextBox Style="{StaticResource FormTextBox}"
                             Text="{Binding TransferPurpose, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Transfer purpose"/>
                    <CheckBox Margin="0,10,0,0"
                              Content="This transfer repeats"
                              IsChecked="{Binding TransferIsRecurring}"
                              AutomationProperties.Name="This transfer repeats"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding TransferFrequencies}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding TransferFrequency}"
                              AutomationProperties.Name="Transfer frequency"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Content="Record transfer"
                            Command="{Binding AddTransferCommand}"
                            AutomationProperties.Name="Record the transfer"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Recorded transfers"/>
                    <ItemsControl ItemsSource="{Binding Transfers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="0"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold">
                                                <Run Text="{Binding From, Mode=OneWay}"/>
                                                <Run Text=" to "/><Run Text="{Binding To, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Amount, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                                <Run Text="{Binding Date, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Recurrence, Mode=OneWay}"/>
                                                <Run Text=" · "/><Run Text="{Binding Purpose, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SecondaryButton}"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveTransferCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="Remove this transfer"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
