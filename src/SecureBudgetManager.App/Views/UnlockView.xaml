<UserControl x:Class="SecureBudgetManager.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,24">
        <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource PageKicker}" Text="PRIVACY"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="Figures are hidden"/>

            <TextBlock Style="{StaticResource PageLead}"
                       Text="{Binding LockReason}"
                       Visibility="{Binding LockReason, Converter={StaticResource NullToVisibilityConverter}}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="This is not database encryption"/>
                    <TextBlock Style="{StaticResource CardBody}"
                               Text="The Privacy screen only hides information while the programme is running. The local SQLite file remains readable to anyone with access to this computer's files. Restarting the programme opens the Dashboard normally."/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,20,0,0"
                            Content="Show household figures"
                            IsDefault="True"
                            Command="{Binding RevealCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                            AutomationProperties.Name="Show household figures"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ErrorCard}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource CardBody}"
                           Foreground="{StaticResource Brush.Text}"
                           Text="{Binding ErrorMessage}"/>
            </Border>

            <TextBlock Style="{StaticResource CardBody}"
                       Margin="0,16,0,0"
                       Foreground="{StaticResource Brush.TextMuted}"
                       Text="Household data stays on this computer. There is no cloud account, vault password or online recovery."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
