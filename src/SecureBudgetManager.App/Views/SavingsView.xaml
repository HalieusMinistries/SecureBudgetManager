<UserControl x:Class="SecureBudgetManager.App.Views.SavingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Sinking funds" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add fund" Command="{Binding BeginAddFundCommand}" AutomationProperties.Name="Add sinking fund"/>
            </Grid>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasFunds, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="No sinking funds yet"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="Add a fund when you need to set money aside for a known future cost, such as repairs or a deductible."/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Funds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableListRow}" Focusable="True" AutomationProperties.Name="{Binding Name}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditFundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <KeyBinding Key="Return"
                                            Command="{Binding DataContext.BeginEditFundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Purpose}"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Progress}"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding WeeklyNeed}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CompactButton}" Content="Edit"
                                            Command="{Binding DataContext.BeginEditFundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Edit fund"/>
                                    <Button Style="{StaticResource DangerButton}" Padding="10,6" FontSize="12" Content="Remove"
                                            Command="{Binding DataContext.RemoveFundCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove fund"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="16,8,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Savings goals" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add goal" Command="{Binding BeginAddGoalCommand}" AutomationProperties.Name="Add savings goal"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Goals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableListRow}" Focusable="True" AutomationProperties.Name="{Binding Name}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditGoalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <KeyBinding Key="Return"
                                            Command="{Binding DataContext.BeginEditGoalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Progress}"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Deadline}"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="{Binding Note}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Edit"
                                        Command="{Binding DataContext.BeginEditGoalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Edit goal"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Trade-offs"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="{Binding ConflictText}"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
