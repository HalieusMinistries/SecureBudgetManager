<UserControl x:Class="SecureBudgetManager.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" MinWidth="200"/>
            <ColumnDefinition Width="*" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="16,16,16,12"
                        Padding="12,10"
                        CornerRadius="8"
                        Background="{StaticResource Brush.AccentMuted}"
                        BorderBrush="{StaticResource Brush.Accent}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="LOCAL ONLY"
                                   Foreground="{StaticResource Brush.Accent}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Stored only on this computer"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="No cloud, banks or telemetry"
                                   Foreground="{StaticResource Brush.TextSecondary}"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Margin="0,4,0,8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel KeyboardNavigation.TabNavigation="Local">
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Dashboard"
                                     Tag="&#xEA37;"
                                     AutomationProperties.Name="Dashboard page"
                                     Command="{Binding NavigateToDashboardCommand}"
                                     IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="This Week"
                                     Tag="&#xE787;"
                                     AutomationProperties.Name="This week guidance page"
                                     Command="{Binding NavigateToThisWeekCommand}"
                                     IsChecked="{Binding IsThisWeekSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Bills &amp; Reservations"
                                     Tag="&#xE9D2;"
                                     AutomationProperties.Name="Bills and reservations page"
                                     Command="{Binding NavigateToAllocationsCommand}"
                                     IsChecked="{Binding IsAllocationsSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Grocery Plan"
                                     Tag="&#xE8EC;"
                                     AutomationProperties.Name="Grocery plan page"
                                     Command="{Binding NavigateToGroceryCommand}"
                                     IsChecked="{Binding IsGrocerySelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Household"
                                     Tag="&#xE77B;"
                                     AutomationProperties.Name="Household page"
                                     Command="{Binding NavigateToHouseholdCommand}"
                                     IsChecked="{Binding IsHouseholdSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Income"
                                     Tag="&#xE8C7;"
                                     AutomationProperties.Name="Income page"
                                     Command="{Binding NavigateToIncomeCommand}"
                                     IsChecked="{Binding IsIncomeSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Expenses"
                                     Tag="&#xE8C8;"
                                     AutomationProperties.Name="Expenses page"
                                     Command="{Binding NavigateToExpensesCommand}"
                                     IsChecked="{Binding IsExpensesSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Payroll"
                                     Tag="&#xE8A5;"
                                     AutomationProperties.Name="Payroll deductions and benefits page"
                                     Command="{Binding NavigateToPayrollCommand}"
                                     IsChecked="{Binding IsPayrollSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Benefits"
                                     Tag="&#xE95E;"
                                     AutomationProperties.Name="Benefits section on the payroll page"
                                     Command="{Binding NavigateToBenefitsCommand}"
                                     IsChecked="{Binding IsBenefitsSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Cash Flow"
                                     Tag="&#xE9D2;"
                                     AutomationProperties.Name="Cash Flow page"
                                     Command="{Binding NavigateToCashFlowCommand}"
                                     IsChecked="{Binding IsCashFlowSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Planning"
                                     Tag="&#xE8EF;"
                                     AutomationProperties.Name="Planning Centre page"
                                     Command="{Binding NavigateToPlanningCommand}"
                                     IsChecked="{Binding IsPlanningSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Debt"
                                     Tag="&#xE8C9;"
                                     AutomationProperties.Name="Debt payoff page"
                                     Command="{Binding NavigateToDebtCommand}"
                                     IsChecked="{Binding IsDebtSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Savings and Sinking Funds"
                                     Tag="&#xE825;"
                                     AutomationProperties.Name="Savings and sinking funds page"
                                     Command="{Binding NavigateToSavingsCommand}"
                                     IsChecked="{Binding IsSavingsSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Actuals"
                                     Tag="&#xE9D5;"
                                     AutomationProperties.Name="Actual balances and transactions page"
                                     Command="{Binding NavigateToActualsCommand}"
                                     IsChecked="{Binding IsActualsSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Local Guidance"
                                     Tag="&#xE909;"
                                     AutomationProperties.Name="Utah and local cost guidance page"
                                     Command="{Binding NavigateToLocalGuidanceCommand}"
                                     IsChecked="{Binding IsLocalGuidanceSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Allocation Rules"
                                     Tag="&#xE8F1;"
                                     AutomationProperties.Name="Allocation rules page"
                                     Command="{Binding NavigateToAllocationRulesCommand}"
                                     IsChecked="{Binding IsAllocationRulesSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Products and Prices"
                                     Tag="&#xE719;"
                                     AutomationProperties.Name="Products and prices page"
                                     Command="{Binding NavigateToProductsCommand}"
                                     IsChecked="{Binding IsProductsSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="International Transfers"
                                     Tag="&#xE8C8;"
                                     AutomationProperties.Name="International transfers page"
                                     Command="{Binding NavigateToInternationalTransfersCommand}"
                                     IsChecked="{Binding IsInternationalTransfersSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Foreign Accounts"
                                     Tag="&#xE8D7;"
                                     AutomationProperties.Name="Foreign accounts page"
                                     Command="{Binding NavigateToForeignAccountsCommand}"
                                     IsChecked="{Binding IsForeignAccountsSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Settings"
                                     Tag="&#xE713;"
                                     AutomationProperties.Name="Settings page"
                                     Command="{Binding NavigateToSettingsCommand}"
                                     IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"/>
                        <RadioButton Style="{StaticResource NavRadioButton}"
                                     GroupName="MainNavigation"
                                     Content="Help and About"
                                     Tag="&#xE897;"
                                     AutomationProperties.Name="Help and about page"
                                     Command="{Binding NavigateToHelpCommand}"
                                     IsChecked="{Binding IsHelpSelected, Mode=OneWay}"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="16,0,16,8"
                            HorizontalAlignment="Stretch"
                            Content="Save"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            AutomationProperties.Name="Save household data to the local database"
                            ToolTip="Writes the household dataset to the local SQLite database."/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="16,0,16,8"
                            HorizontalAlignment="Stretch"
                            Content="Undo last change"
                            Command="{Binding UndoCommand}"
                            AutomationProperties.Name="Undo last household change"
                            ToolTip="Restores the previous in-memory document. Save to write it."/>
                    <TextBlock Margin="20,0,16,8"
                               Foreground="{StaticResource Brush.Accent}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Unsaved changes"
                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Style="{StaticResource LockButton}"
                            Content="Privacy"
                            Command="{Binding LockWorkspaceCommand}"
                            AutomationProperties.Name="Hide figures on screen"
                            ToolTip="Hide figures on this screen. This is not database encryption. Restarting still opens the Dashboard."/>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="20,0,16,16"
                           Text="Stored only on this computer"
                           Foreground="{StaticResource Brush.TextMuted}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource Brush.AccentMuted}"
                    BorderBrush="{StaticResource Brush.Accent}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource Brush.Accent}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Foreground="{StaticResource Brush.Text}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource DismissButton}"
                            Content="&#xE8BB;"
                            Command="{Binding DismissStatusCommand}"
                            AutomationProperties.Name="Dismiss message"
                            ToolTip="Dismiss"/>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost"
                            Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>
