<UserControl x:Class="SecureBudgetManager.App.Views.DebtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Add a loan or card"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Debt name"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Kind"/>
                    <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding KindOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Kind}" AutomationProperties.Name="Debt kind"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Balance"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Balance, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Debt balance"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="APR %"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Apr, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Debt APR"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Minimum payment"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minimum payment"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Promotional APR % (optional)"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding PromotionalApr, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Promotional APR"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Promotional rate expires"/>
                    <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding PromotionalEnds}" AutomationProperties.Name="Promotional rate expiry"/>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Save debt" Command="{Binding AddDebtCommand}" AutomationProperties.Name="Save debt"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Debts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding Balance, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Apr, Mode=OneWay}"/>
                                        <Run Text=" · min "/>
                                        <Run Text="{Binding Minimum, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource DangerButton}" Padding="10,6" FontSize="12" Content="Remove"
                                        Command="{Binding DataContext.RemoveDebtCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Remove debt"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Snowball versus avalanche"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Extra monthly budget above minimums"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ExtraBudget, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Extra debt budget"/>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Compare strategies" Command="{Binding CompareCommand}" AutomationProperties.Name="Compare payoff strategies"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="{Binding ComparisonText}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
