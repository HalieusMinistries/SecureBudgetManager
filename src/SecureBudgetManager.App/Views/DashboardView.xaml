<UserControl x:Class="SecureBudgetManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource PeriodToggle}"
                             GroupName="DashboardPeriod"
                             Content="Weekly"
                             Command="{Binding ShowWeeklyCommand}"
                             IsChecked="{Binding IsWeekly, Mode=OneWay}"
                             AutomationProperties.Name="Show weekly figures"/>
                <RadioButton Style="{StaticResource PeriodToggle}"
                             GroupName="DashboardPeriod"
                             Content="Average monthly"
                             Command="{Binding ShowAverageMonthlyCommand}"
                             IsChecked="{Binding IsAverageMonthly, Mode=OneWay}"
                             AutomationProperties.Name="Show average monthly figures"/>
                <RadioButton Style="{StaticResource PeriodToggle}"
                             GroupName="DashboardPeriod"
                             Content="Annual"
                             Command="{Binding ShowAnnualCommand}"
                             IsChecked="{Binding IsAnnual, Mode=OneWay}"
                             AutomationProperties.Name="Show annual figures"/>
            </StackPanel>
            <TextBlock Style="{StaticResource HintText}"
                       Margin="0,0,0,16"
                       Text="{Binding Overview.PeriodLabel, StringFormat=Showing {0} figures. Average monthly is annual ÷ 12 and is not money available today.}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Money available now"/>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding AvailableNowText}"/>
                    <TextBlock Style="{StaticResource CardBody}" TextWrapping="Wrap" Text="{Binding SpendingSafetyNotice}"/>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                        <Run Text="Reserved "/><Run Text="{Binding ReservedText, Mode=OneWay}"/>
                        <Run Text=" · safe to spend before next income "/><Run Text="{Binding SafeToSpendNowText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding NextIncomeText}"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding People}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}"/>
                                <TextBlock Style="{StaticResource CardBody}" TextWrapping="Wrap" Text="{Binding NextIncomeText}"/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding FirstDepositText}"/>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                    <Run Text="Personal available "/><Run Text="{Binding AvailableNowText, Mode=OneWay}"/>
                                    <Run Text=" · safe to spend "/><Run Text="{Binding SafeToSpendText, Mode=OneWay}"/>
                                    <Run Text=" · take-home forecast "/><Run Text="{Binding TakeHomeText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasUnassignedObligations, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Unassigned household obligations"/>
                    <ItemsControl ItemsSource="{Binding UnassignedObligations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding Overview.GrossIncome.Label}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Overview.GrossIncome.Text}"/>
                        <TextBlock Style="{StaticResource EstimatedBadge}"
                                   Text="Estimated"
                                   Visibility="{Binding Overview.GrossIncome.IsEstimated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding Overview.PayrollDeductions.Label}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Overview.PayrollDeductions.Text}"/>
                        <TextBlock Style="{StaticResource EstimatedBadge}"
                                   Text="Estimated"
                                   Visibility="{Binding Overview.PayrollDeductions.IsEstimated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding Overview.EstimatedTaxes.Label}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Overview.EstimatedTaxes.Text}"/>
                        <TextBlock Style="{StaticResource EstimatedBadge}"
                                   Text="Estimated"
                                   Visibility="{Binding Overview.EstimatedTaxes.IsEstimated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding Overview.RecurringExpenses.Label}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Overview.RecurringExpenses.Text}"/>
                        <TextBlock Style="{StaticResource EstimatedBadge}"
                                   Text="Estimated"
                                   Visibility="{Binding Overview.RecurringExpenses.IsEstimated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding Overview.TakeHomePay.Label}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Overview.TakeHomePay.Text}"/>
                        <TextBlock Style="{StaticResource EstimatedBadge}"
                                   Text="Estimated"
                                   Visibility="{Binding Overview.TakeHomePay.IsEstimated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding CombinedForecastLabel}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Overview.NetCashFlow.Text}"/>
                        <TextBlock Style="{StaticResource EstimatedBadge}"
                                   Text="Estimated"
                                   Visibility="{Binding Overview.NetCashFlow.IsEstimated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding Overview.SafeToSpend.Label}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Overview.SafeToSpend.Text}"/>
                        <TextBlock Style="{StaticResource EstimatedBadge}"
                                   Text="Estimated"
                                   Visibility="{Binding Overview.SafeToSpend.IsEstimated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabel}" Text="{Binding Overview.LowestProjectedBalance.Label}"/>
                        <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Overview.LowestProjectedBalance.Text}"/>
                        <TextBlock Style="{StaticResource EstimatedBadge}"
                                   Text="Estimated"
                                   Visibility="{Binding Overview.LowestProjectedBalance.IsEstimated, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasAttention, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="What needs attention?"/>
                    <ItemsControl ItemsSource="{Binding Attention}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CardBody}"
                                           Margin="0,0,0,8"
                                           Text="{Binding Message}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
