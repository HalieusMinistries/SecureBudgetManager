<UserControl x:Class="SecureBudgetManager.App.Views.ForeignAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:interaction="clr-namespace:SecureBudgetManager.App.Interaction"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20"
                  interaction:ScrollRestore.VerticalOffset="{Binding ListScrollOffset, Mode=TwoWay}">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Foreign accounts" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add account" Command="{Binding BeginAddCommand}" AutomationProperties.Name="Add foreign account"/>
            </Grid>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding HasAccounts, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="No foreign accounts yet"/>
                    <TextBlock Style="{StaticResource CardBody}" Text="Add a nickname, country and currency. Click a row to select it. Double-click or choose Edit to open it. Do not store passwords or PINs."/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SelectableListRow}" Focusable="True" AutomationProperties.Name="{Binding Nickname}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"/>
                                <KeyBinding Key="Return"
                                            Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Text="{Binding Nickname}"/>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                        <Run Text="{Binding Institution, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding Country, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding Currency, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                        <Run Text="{Binding HighBalance, Mode=OneWay}"/>
                                        <Run Text=" · "/><Run Text="{Binding Review, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="Edit"
                                        Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Edit foreign account"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Possible reporting reminders"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tax year"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding ReminderYear, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reporting tax year"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Filing status"/>
                    <ComboBox Style="{StaticResource FormComboBox}" ItemsSource="{Binding FilingOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding FilingStatus}" AutomationProperties.Name="Reporting filing status"/>
                    <CheckBox Style="{StaticResource ThemedCheckBox}" Margin="0,12,0,0" Content="Lives in the United States" IsChecked="{Binding LivesInUnitedStates}" AutomationProperties.Name="Lives in the United States"/>
                    <ItemsControl ItemsSource="{Binding Reminders}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" Text="{Binding Form}"/>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Message}"/>
                                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Text="{Binding Source}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Supporting document reference"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Title"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding DocumentTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supporting document title"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Kind"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding DocumentKind, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Supporting document kind"/>
                    <Button Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Content="Save document reference" Command="{Binding SaveDocumentCommand}" AutomationProperties.Name="Save supporting document reference"/>
                    <ItemsControl ItemsSource="{Binding Documents}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}"/>
                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource Brush.Danger}" Text="{Binding ErrorMessage}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
