<UserControl x:Class="SecureBudgetManager.App.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20">
        <StackPanel>
            <TextBlock Style="{StaticResource PageKicker}" Text="{Binding Kicker}"/>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}"/>
            <TextBlock Style="{StaticResource PageLead}" Text="{Binding Summary}"/>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="No expenses yet"/>
                    <TextBlock Style="{StaticResource CardBody}"
                               Text="Add rent, bills and other recurring costs. Weekly, fortnightly, twice-monthly, monthly, quarterly and annual schedules are converted through an annual total."/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Recurring expenses" VerticalAlignment="Center" Margin="0"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add expense" Command="{Binding BeginAddCommand}" AutomationProperties.Name="Add expense"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0">
                                        <Run Text="{Binding Owner, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Necessity, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Frequency, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Status, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource HintText}">
                                        <Run Text="{Binding Weekly, Mode=OneWay}"/>
                                        <Run Text=" weekly · "/>
                                        <Run Text="{Binding Monthly, Mode=OneWay}"/>
                                        <Run Text=" average monthly · "/>
                                        <Run Text="{Binding Annual, Mode=OneWay}"/>
                                        <Run Text=" a year"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CompactButton}" Content="Edit"
                                            Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Edit expense"/>
                                    <Button Style="{StaticResource CompactButton}" Content="Duplicate"
                                            Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Duplicate expense"/>
                                    <Button Style="{StaticResource DangerButton}" Padding="10,6" FontSize="12" Content="Remove"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="Remove expense"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding EditorTitle}"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Expense name"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expense name"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Owner"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding OwnerOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding EditorOwnerId}"
                              AutomationProperties.Name="Expense owner"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Category"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding CategoryOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding EditorCategory}"
                              AutomationProperties.Name="Expense category"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Essential or optional"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding NecessityOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding EditorNecessity}"
                              AutomationProperties.Name="Expense necessity"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Amount"/>
                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding EditorAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Expense amount"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Frequency"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding FrequencyOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding EditorFrequency}"
                              AutomationProperties.Name="Expense frequency"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Due date (anchors recurrence)"/>
                    <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding EditorDueDate}" AutomationProperties.Name="Expense due date"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="End date (optional)"/>
                    <DatePicker Style="{StaticResource FormDatePicker}" SelectedDate="{Binding EditorEndDate}" AutomationProperties.Name="Expense end date"/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fixed or variable"/>
                    <ComboBox Style="{StaticResource FormComboBox}"
                              ItemsSource="{Binding VariabilityOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding EditorVariability}"
                              AutomationProperties.Name="Expense variability"/>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="For a variable expense, enter the amount you expect to spend each time."
                               Visibility="{Binding IsVariable, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <CheckBox Style="{StaticResource ThemedCheckBox}"
                              Margin="0,12,0,0"
                              Content="Active"
                              IsChecked="{Binding EditorIsActive}"
                              AutomationProperties.Name="Expense is active"/>

                    <TextBlock Style="{StaticResource HintText}" Text="{Binding EquivalentSummary}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="Save expense" Command="{Binding SaveEntryCommand}" AutomationProperties.Name="Save expense"/>
                        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelEditorCommand}" AutomationProperties.Name="Cancel expense editor"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ErrorCard}"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Style="{StaticResource CardBody}" Foreground="{StaticResource Brush.Text}" Text="{Binding ErrorMessage}"/>
            </Border>
            <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
