<Application x:Class="SecureBudgetManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SecureBudgetManager.App.Views"
             xmlns:vm="clr-namespace:SecureBudgetManager.App.ViewModels"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/DatePicker.xaml"/>
                <ResourceDictionary Source="Themes/SecurityControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:SetupViewModel}">
                <Grid>
                    <views:SetupView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UnlockViewModel}">
                <Grid>
                    <views:UnlockView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MainViewModel}">
                <Grid>
                    <views:WorkspaceView/>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <Grid>
                    <views:DashboardView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ThisWeekViewModel}">
                <Grid>
                    <views:ThisWeekView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AllocationsViewModel}">
                <Grid>
                    <views:AllocationsView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GroceryPlanViewModel}">
                <Grid>
                    <views:GroceryPlanView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LocalGuidanceViewModel}">
                <Grid>
                    <views:LocalGuidanceView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AllocationRulesViewModel}">
                <Grid>
                    <views:AllocationRulesView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <Grid>
                    <views:ProductsView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InternationalTransfersViewModel}">
                <Grid>
                    <views:InternationalTransfersView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ForeignAccountsViewModel}">
                <Grid>
                    <views:ForeignAccountsView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HouseholdViewModel}">
                <Grid>
                    <views:HouseholdView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:IncomeViewModel}">
                <Grid>
                    <views:IncomeView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
                <Grid>
                    <views:ExpensesView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PayrollViewModel}">
                <Grid>
                    <views:PayrollView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CashFlowViewModel}">
                <Grid>
                    <views:CashFlowView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlanningViewModel}">
                <Grid>
                    <views:PlanningView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DebtViewModel}">
                <Grid>
                    <views:DebtView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SavingsViewModel}">
                <Grid>
                    <views:SavingsView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActualsViewModel}">
                <Grid>
                    <views:ActualsView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <Grid>
                    <views:SettingsView/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HelpViewModel}">
                <Grid>
                    <views:HelpView/>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
